[Unit]
Description=Homelab host default deny (owned by Ansible)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target network.target k3s.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment="PATH={{ '/run/current-system/sw/bin:/run/current-system/sw/sbin' if host_os == 'nixos' else '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' }}"
ExecStart={{ ansible_python_interpreter | default('/usr/bin/python3') }} /var/lib/homelab/host_firewall.py
ExecReload={{ ansible_python_interpreter | default('/usr/bin/python3') }} /var/lib/homelab/host_firewall.py
# No ExecStop: stopping systemd ownership never removes enforcement.

[Install]
WantedBy=network-pre.target
