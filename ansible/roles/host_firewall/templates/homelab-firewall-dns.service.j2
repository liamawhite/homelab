[Unit]
Description=Refresh approved host egress addresses
Wants=network-online.target
After=network-online.target homelab-host-firewall.service
Requires=homelab-host-firewall.service

[Service]
Type=oneshot
Environment="PATH={{ '/run/current-system/sw/bin:/run/current-system/sw/sbin' if host_os == 'nixos' else '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' }}"
ExecStart={{ ansible_python_interpreter | default('/usr/bin/python3') }} /var/lib/homelab/host_firewall.py --resolve
